{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure MSXPAD2USB",
            "type": "shell",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v4.3.4/bin/cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DPICO_SDK_PATH=${env:USERPROFILE}/.pico-sdk/sdk/2.3.0",
                "-DPICO_TOOLCHAIN_PATH=${env:USERPROFILE}/.pico-sdk/toolchain/15_2_Rel1",
                "-DPICO_BOARD=seeed_xiao_rp2350",
                "-DCMAKE_MAKE_PROGRAM=${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build MSXPAD2USB",
            "type": "shell",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v4.3.4/bin/cmake.exe",
            "args": ["--build", "${workspaceFolder}/build"],
            "dependsOn": "Configure MSXPAD2USB",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": "$gcc"
        }
    ]
}
